{
  "name": "placecampus",
  "version": "0.1.0",
  "private": true,
  "description": "PlaceCampus — Unified Placement & Student Readiness Platform",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @placecampus/web dev",
    "dev:api": "pnpm --filter @placecampus/api dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @placecampus/web build",
    "build:api": "pnpm --filter @placecampus/api build",
    "lint": "pnpm -r run lint",
    "lint:web": "pnpm --filter @placecampus/web lint",
    "lint:api": "pnpm --filter @placecampus/api lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "pnpm -r exec rimraf dist .next node_modules/.cache",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "echo 'Ready'"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
