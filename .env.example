# ========================
# PlaceCampus Environment
# ========================

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/placecampus

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=your-storage-endpoint
STORAGE_BUCKET=placecampus-uploads
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Document storage (Cloudinary when configured; otherwise local uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI document analysis (advisory; faculty make every decision). Provider: groq | openai | none.
# Without a key the pipeline runs on rules and OCR only.
AI_PROVIDER=groq
AI_API_KEY=your-ai-api-key
# Must support strict JSON-schema structured outputs (Groq: openai/gpt-oss-120b or openai/gpt-oss-20b).
AI_MODEL=openai/gpt-oss-120b
# Kill switches: AI_ENABLED=false turns AI off everywhere; list evidence types to exclude.
AI_ENABLED=true
AI_DISABLED_EVIDENCE_TYPES=
# Optional tuning
# AI_TIMEOUT_MS=120000
# AI_MAX_RETRIES=2
# AI_MAX_TEXT_CHARS=12000
# AI_MAX_CANDIDATE_SKILLS=200
# AI_BASE_URL=

# OCR / Document Extraction (local: PDF text layer + Tesseract OCR for images and scanned pages)
# Set to false to skip OCR; scanned pages are then marked PARTIAL for the reviewer.
OCR_ENABLED=true
# Maximum scanned pages OCR'd per document, and per-page timeout.
OCR_MAX_PAGES=10
OCR_PAGE_TIMEOUT_MS=60000
# English language data is downloaded here on first use (default: <api dir>/.cache/tessdata).
# OCR_LANG_CACHE_DIR=
# For offline installs: directory or URL that already holds eng.traineddata.gz.
# OCR_LANG_PATH=

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Search
SEARCH_URL=http://localhost:7700
SEARCH_API_KEY=your-search-api-key

# External Integrations
CODING_PLATFORM_API_KEY=your-coding-platform-key
CERTIFICATION_API_KEY=your-certification-api-key

# Bulk imports
# Comma-separated institution email domains; imported emails outside them are rejected.
# Leave empty to skip the domain check (rows are then flagged EMAIL_DOMAIN_NOT_CONFIGURED).
INSTITUTION_EMAIL_DOMAINS=
# Demo/sample-data imports are allowed outside production only, unless this is true.
ALLOW_DEMO_IMPORTS=false
