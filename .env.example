# ========================
# PlaceCampus Environment
# ========================

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/placecampus

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=your-storage-endpoint
STORAGE_BUCKET=placecampus-uploads
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# AI Service
AI_API_KEY=your-ai-api-key
AI_PROVIDER=openai
AI_MODEL=gpt-4

# OCR / Document Extraction
OCR_API_KEY=your-ocr-api-key
OCR_PROVIDER=your-ocr-provider

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Search
SEARCH_URL=http://localhost:7700
SEARCH_API_KEY=your-search-api-key

# External Integrations
CODING_PLATFORM_API_KEY=your-coding-platform-key
CERTIFICATION_API_KEY=your-certification-api-key
